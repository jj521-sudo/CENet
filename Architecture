import torch
import torch.nn as nn
from torch.utils.checkpoint import checkpoint


class DualAttention3d(nn.Module):
    def __init__(self, channels, k_time=3):
        super().__init__()
        self.channel_mlp = nn.Sequential(
            nn.Linear(channels, channels // 2, bias=False),
            nn.SiLU(inplace=True),
            nn.Linear(channels // 2, channels, bias=False)
        )

        self.spatial_conv = nn.Conv3d(
            2, 1,
            kernel_size=(k_time, 3, 3),
            padding=(k_time // 2, 1, 1),
            bias=False
        )
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        avg_c = torch.mean(x, dim=(2, 3, 4))
        max_c = torch.amax(x, dim=(2, 3, 4))
        c_attn = self.sigmoid(
            self.channel_mlp(avg_c) + self.channel_mlp(max_c)
        )
        x = x * c_attn.view(-1, x.size(1), 1, 1, 1)

        s_avg = torch.mean(x, dim=1, keepdim=True)
        s_max, _ = torch.max(x, dim=1, keepdim=True)
        s_input = torch.cat([s_avg, s_max], dim=1)
        s_attn = self.sigmoid(self.spatial_conv(s_input))
        return x * s_attn


class LightResBlock3d_v2(nn.Module):
    def __init__(self, in_channels, out_channels, stride=(1, 1, 1), time_pad=0):
        super().__init__()
        k_time = 5 if time_pad > 0 else 4

        self.conv1 = nn.Conv3d(
            in_channels, out_channels,
            kernel_size=(k_time, 3, 3),
            stride=stride,
            padding=(time_pad, 1, 1),
            bias=False
        )
        self.norm1 = nn.InstanceNorm3d(out_channels, affine=True)
        self.attn = DualAttention3d(out_channels, k_time=3)
        self.act = nn.SiLU(inplace=True)

        if stride != (1, 1, 1) or in_channels != out_channels:
            self.shortcut = nn.Sequential(
                nn.Conv3d(
                    in_channels, out_channels,
                    kernel_size=1,
                    stride=stride,
                    bias=False
                ),
                nn.InstanceNorm3d(out_channels, affine=True)
            )
        else:
            self.shortcut = nn.Identity()

    def forward(self, x):
        residual = self.shortcut(x)
        x = self.conv1(x)
        x = self.norm1(x)
        x = self.attn(x)
        x.add_(residual)
        return self.act(x)


class WaveAttentionPooling3d(nn.Module):
    def __init__(self, channels):
        super().__init__()
        self.fusion_conv = nn.Sequential(
            nn.Conv3d(channels * 2, channels, kernel_size=1, bias=False),
            nn.InstanceNorm3d(channels, affine=True),
            nn.SiLU(inplace=True)
        )

    def forward(self, x):
        avg_out = torch.mean(x, dim=2, keepdim=True)
        max_out, _ = torch.max(x, dim=2, keepdim=True)
        fused = torch.cat([avg_out, max_out], dim=1)
        return self.fusion_conv(fused)


class SmoothResBlock2d(nn.Module):
    def __init__(self, channels):
        super().__init__()
        self.smooth_conv = nn.Sequential(
            nn.ReflectionPad2d(2),
            nn.Conv2d(
                channels, channels,
                kernel_size=5,
                groups=channels,
                bias=False
            ),
            nn.InstanceNorm2d(channels, affine=True),
            nn.SiLU(inplace=True),
            nn.Conv2d(channels, channels, kernel_size=1, bias=False),
            nn.InstanceNorm2d(channels, affine=True)
        )
        self.act = nn.SiLU(inplace=True)

    def forward(self, x):
        return self.act(x + self.smooth_conv(x))


class SmoothMIPDecoder(nn.Module):
    def __init__(self, in_channels=16, out_channels=1):
        super().__init__()
        self.initial = nn.Sequential(
            nn.ReflectionPad2d(1),
            nn.Conv2d(in_channels, 16, kernel_size=3, bias=False),
            nn.InstanceNorm2d(16, affine=True),
            nn.SiLU(inplace=True)
        )
        self.smooth_blocks = nn.Sequential(
            SmoothResBlock2d(16),
            SmoothResBlock2d(16)
        )
        self.final = nn.Conv2d(16, out_channels, kernel_size=3, padding=1)

    def forward(self, x):
        return self.final(self.smooth_blocks(self.initial(x)))


class OCE_Spatiotemporal_atten_sm(nn.Module):
    def __init__(self, in_channels=2, mip_channels=1, chunk_size=50):
        super().__init__()
        self.chunk_size = chunk_size

        self.wave_tracker = nn.Sequential(
            LightResBlock3d_v2(
                in_channels, 8,
                stride=(4, 1, 1),
                time_pad=2
            ),
            LightResBlock3d_v2(
                8, 16,
                stride=(2, 1, 1),
                time_pad=2
            ),
            WaveAttentionPooling3d(16)
        )

        self.depth_compressor = nn.Sequential(
            LightResBlock3d_v2(
                16, 32,
                stride=(4, 1, 1),
                time_pad=0
            ),
            LightResBlock3d_v2(
                32, 16,
                stride=(4, 1, 1),
                time_pad=0
            ),
            WaveAttentionPooling3d(16)
        )

        self.mip_decoder = SmoothMIPDecoder(
            in_channels=16,
            out_channels=mip_channels
        )

    def forward(self, x):
        B, C, R, Y, T, Z = x.shape

        x = x.permute(0, 5, 1, 4, 3, 2).contiguous()
        x = x.reshape(B * Z, C, T, Y, R)

        tracker_outs = []
        num_items = B * Z

        for start_idx in range(0, num_items, self.chunk_size):
            end_idx = min(start_idx + self.chunk_size, num_items)
            chunk = x[start_idx:end_idx]

            if self.training:
                out_chunk = checkpoint(
                    self.wave_tracker,
                    chunk,
                    use_reentrant=False
                )
            else:
                out_chunk = self.wave_tracker(chunk)

            tracker_outs.append(out_chunk)

        x = torch.cat(tracker_outs, dim=0)
        del tracker_outs, chunk
        x = x.squeeze(2)

        _, C_out, Y_, R_ = x.shape
        x = x.reshape(B, Z, C_out, Y_, R_)
        x = x.permute(0, 2, 1, 3, 4).contiguous()

        if self.training:
            x = checkpoint(
                self.depth_compressor,
                x,
                use_reentrant=False
            )
        else:
            x = self.depth_compressor(x)

        x = x.squeeze(2)
        out_mip = self.mip_decoder(x)
        return out_mip


if __name__ == "__main__":
    dummy_input = torch.randn(1, 2, 50, 50, 400, 384)

    model = OCE_Spatiotemporal_atten_sm(chunk_size=64)
    model.eval()

    print("Running forward inference...")
    with torch.no_grad():
        out = model(dummy_input)

    total_params = sum(p.numel() for p in model.parameters())

    print(f"Input shape: {dummy_input.shape}")
    print(f"Output shape: {out.shape} (expected: [1, 1, 50, 50])")
    print(
        f"Total parameters: {total_params / 1e3:.2f} K "
        f"({total_params / 1e6:.3f} M)"
    )
